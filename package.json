{
  "name": "@anubhav0712/tools-mcp",
  "version": "0.1.0",
  "description": "100% In-Browser & Local-First Utility Tools with Stdio MCP Server for AI Agents",
  "type": "module",
  "author": "anubhav0712",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anubhav0712/tools.git"
  },
  "homepage": "https://anubhav0712.github.io/tools/",
  "scripts": {
    "dev": "vite",
    "build": "npm run export-mcp && npm run build:cli && npm run build:web",
    "build:cli": "tsx scripts/build-mcp-cli.ts",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "new-tool": "tsx scripts/new-tool.ts",
    "export-mcp": "tsx scripts/export-mcp.ts",
    "mcp": "tsx scripts/mcp-server.ts"
  },
  "bin": {
    "tools-mcp": "./bin/tools-mcp.cjs"
  },
  "files": [
    "bin",
    "public/mcp-manifest.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
