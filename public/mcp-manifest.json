{
  "server": {
    "name": "tools-client-suite",
    "version": "0.1.0",
    "description": "Privacy-first, 100% local client-side tool execution suite."
  },
  "tools": [
    {
      "name": "base64-converter",
      "description": "Encode and decode standard or URL-safe Base64 strings with full UTF-8 Unicode support.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text or Base64 string to encode/decode"
          },
          "mode": {
            "type": "string",
            "enum": [
              "encode",
              "decode"
            ],
            "default": "encode",
            "description": "Operation mode: encode or decode"
          },
          "urlSafe": {
            "type": "boolean",
            "default": false,
            "description": "Use URL-safe alphabet (- and _ instead of + and /)"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "description": "Encoded or decoded string"
          },
          "isValid": {
            "type": "boolean",
            "description": "Whether the operation succeeded"
          },
          "error": {
            "type": "string",
            "description": "Error message if decoding failed"
          },
          "byteSize": {
            "type": "number",
            "description": "Byte length of the result"
          }
        },
        "required": [
          "result",
          "isValid",
          "byteSize"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "category": "converter",
        "version": "1.0.0",
        "keywords": [
          "base64",
          "encode",
          "decode",
          "b64",
          "urlsafe",
          "ascii",
          "utf8"
        ],
        "deepLinkSupported": true,
        "agentPrompt": "Encode plain text to Base64 or decode Base64 strings back to UTF-8 text."
      }
    },
    {
      "name": "json-formatter",
      "description": "Format, validate, sort object keys, or minify JSON data with instant local parsing and syntax validation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rawJson": {
            "type": "string",
            "description": "The raw JSON string to format, validate, or minify"
          },
          "indent": {
            "type": "number",
            "minimum": 0,
            "maximum": 8,
            "default": 2,
            "description": "Indentation spaces (0 for minification, default 2)"
          },
          "sortKeys": {
            "type": "boolean",
            "default": false,
            "description": "Whether to sort JSON object keys alphabetically"
          }
        },
        "required": [
          "rawJson"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "formatted": {
            "type": "string",
            "description": "Formatted or minified JSON string"
          },
          "isValid": {
            "type": "boolean",
            "description": "Whether the input was valid JSON"
          },
          "error": {
            "type": "string",
            "description": "Error message if invalid"
          },
          "lineCount": {
            "type": "number",
            "description": "Number of lines in the output"
          },
          "byteSize": {
            "type": "number",
            "description": "Output size in bytes"
          }
        },
        "required": [
          "formatted",
          "isValid",
          "lineCount",
          "byteSize"
        ],
        "additionalProperties": false
      },
      "metadata": {
        "category": "developer",
        "version": "1.0.0",
        "keywords": [
          "json",
          "format",
          "minify",
          "prettify",
          "validate",
          "sort keys",
          "beautify"
        ],
        "deepLinkSupported": true,
        "agentPrompt": "Use this tool to safely format, validate, minify, or canonicalize JSON payloads without sending data to external APIs."
      }
    }
  ]
}